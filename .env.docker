# Environment variables for Docker Compose
# Copy this to .env and customize for your environment

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=swifteats

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-characters-long
JWT_EXPIRATION=5m

# Application
NODE_ENV=production
PORT=4000

# Cache
CACHE_TTL=300
CACHE_MAX=1000

# Logging
LOG_LEVEL=info

# GPS Simulator (optional - only needed if running simulator)
# Generate tokens by logging in as drivers, then add them here
DRIVER_TOKENS=
