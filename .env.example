# Application
NODE_ENV=development
PORT=4000
API_VERSION=v1
API_PREFIX=api

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=swifteats
DB_USER=swifteats_user
DB_PASSWORD=secure_password
DB_SYNCHRONIZE=false
DB_LOGGING=true

# JWT
JWT_SECRET=ce96015762ecec09a8d023e99f06c3e1a987eb26b08ee95f7a3f6b704f8e09cd
JWT_EXPIRES_IN=300
JWT_EXPIRATION=5m

# Session
SESSION_TIMEOUT_MINS=5

# Business Rules
ORDER_CANCELLATION_WINDOW_MINS=1
RESTAURANT_ACCEPTANCE_TIMEOUT_MINS=15
DELIVERY_FEE=40.00
TAX_RATE=0.05
DRIVER_EARNINGS_PER_DELIVERY=50.00
RESTAURANT_SERVICE_RADIUS_KM=5.0

# Cache
CACHE_TTL_SECONDS=300
CACHE_MAX_ITEMS=1000

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# CORS
CORS_ORIGIN=*

# Swagger
SWAGGER_ENABLED=true
SWAGGER_TITLE=SwiftEats API
SWAGGER_DESCRIPTION=Real-Time Food Delivery Platform API
SWAGGER_VERSION=1.0

# GPS Tracking
GPS_BATCH_SIZE=100
GPS_BATCH_INTERVAL_MS=1000
GPS_DATA_RETENTION_DAYS=7

# pg-boss
PG_BOSS_RETRY_LIMIT=3
PG_BOSS_RETRY_DELAY=5
PG_BOSS_EXPIRE_IN_SECONDS=3600
PG_BOSS_ARCHIVE_COMPLETED_AFTER_SECONDS=86400
